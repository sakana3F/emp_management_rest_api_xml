<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE generatorConfiguration PUBLIC "-//mybatis.org//DTD
  MyBatis Generator Configuration 1.0//EN"
    "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">
<generatorConfiguration>
    <classPathEntry
        location="src/main/libs/postgresql-42.7.1.jar"/>
    <context id="postgresContext" targetRuntime="MyBatis3Kotlin">
        <plugin type="org.mybatis.generator.plugins.MapperAnnotationPlugin"/>
        <commentGenerator>
            <property name="suppressDate" value="true"/>
        </commentGenerator>
        <jdbcConnection
                driverClass="org.postgresql.Driver"
                connectionURL="jdbc:postgresql://localhost:5432/employee_testdb"
                userId="postgres"
                password="postgres">
            <property name="nullCatalogMeansCurrent" value="true" />
        </jdbcConnection>
        <javaModelGenerator
            targetPackage="com.example.demo.database"
            targetProject="src/main/kotlin">
        </javaModelGenerator>
        <javaClientGenerator
            targetPackage="com.example.demo.database"
            targetProject="src/main/kotlin">
        </javaClientGenerator>
        <table tableName="administrators"/>
        <table tableName="employees"/>
    </context>
</generatorConfiguration>
